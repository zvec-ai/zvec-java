<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Checkstyle rules for zvec-java.

  Deliberately narrow: every check below catches a real defect class (a
  swallowed switch fall-through, an equals() without hashCode(), a string
  compared with ==, an unused import hiding a wrong dependency) rather than
  arguing about indentation. Formatting is left to the IDE so that diffs stay
  reviewable and contributors are not blocked on whitespace.

  Run it with:  mvn checkstyle:check
  CI runs the same goal in the `lint` job of .github/workflows/ci.yml.

  ZvecNative.java is excluded in pom.xml: it is generated by the JavaCPP
  parser from zvec/src/include/zvec/c_api.h and must stay byte-for-byte
  reproducible, so it is not ours to reformat.
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>
    <!-- Pin the message locale: without it a contributor on a non-English JDK
         gets violations nobody else can read, and CI logs vary by runner. -->
    <property name="localeLanguage" value="en"/>
    <property name="localeCountry" value="US"/>

    <!-- A missing final newline breaks `cat` and diff output on Unix. -->
    <module name="NewlineAtEndOfFile"/>
    <!-- Tabs render differently in every editor; the sources use spaces. -->
    <module name="FileTabCharacter"/>

    <module name="TreeWalker">
        <!-- File and type layout -->
        <module name="OuterTypeFilename"/>
        <module name="OneTopLevelClass"/>
        <module name="PackageDeclaration"/>

        <!-- Correctness -->
        <module name="CovariantEquals"/>
        <module name="EqualsHashCode"/>
        <module name="StringLiteralEquality"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="DefaultComesLast"/>
        <module name="FallThrough"/>
        <module name="MissingSwitchDefault"/>
        <module name="EmptyStatement"/>
        <!-- Swallowing an exception is allowed only when the variable name
             says so, otherwise the empty block hides a real failure. -->
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="ignored|expected"/>
        </module>

        <!-- Imports and modifiers -->
        <module name="RedundantImport"/>
        <module name="UnusedImports">
            <property name="processJavadoc" value="true"/>
        </module>
        <module name="ModifierOrder"/>

        <!-- Java idioms -->
        <module name="ArrayTypeStyle"/>
        <module name="UpperEll"/>
    </module>
</module>
