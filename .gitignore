# Maven
target/
dependency-reduced-pom.xml
*.class

# JavaCPP generated sources & native build artifacts
src/main/java/org/zvec/binding/ZvecNative.java
*.o
*.so
*.dylib
*.dll
*.jnilib

# Native bundles staged for the multi-platform JAR. The publish-jar workflow
# drops every platform's libraries under src/main/resources/org/zvec/binding/
# before running `mvn package`; the shared libraries are already covered by the
# patterns above, but a Windows bundle also carries import libraries (.lib),
# which would otherwise show up as untracked files after a local release build.
src/main/resources/org/zvec/binding/*/

# IDE
.idea/
*.iml
*.iws
*.ipr
.classpath
.project
.settings/
.vscode/

# OS
.DS_Store
Thumbs.db

# Test temp dirs
tmp/
scratch/

# JVM crash logs
hs_err_pid*.log
replay_pid*.log
